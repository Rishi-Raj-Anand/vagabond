<%- layout('/layouts/boilerplate.ejs') -%>
<script>
    const mapToken="<%=process.env.MAP_TOKEN%>";
    const coordinates= <%-JSON.stringify(listing.geometry.coordinates)%>
</script>
<div class="show-wrapper mx-auto">
    <h2 class="show-title"><%= listing.title %></h2>
    <img src="<%= listing.image %>" width="500px" height="400px" alt="Image" class="show-img">
    <div class="show-desc">
        <p>₹ <%= listing.price.toLocaleString("en-IN") %>/night </p>

        
        <p class="italic"><%= listing.description %></p>
        
        <div class="show-btns">
            <p class="italic"><%= listing.location %>,<%= listing.country%></p>
            <p class=""><i>~ <%= listing.owner.username%></i></p>
        </div>
        

        
    </div>
    <div class="show-btns">
        <%if (currUser && currUser._id.equals(listing.owner._id)){%>
        <div class="show-btn">
            <form action="/listings/<%= listing._id %>/edit" method="get">
                <button class="btn btn-danger">Edit</button> 
            </form>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                <button class="btn btn-dark">Delete</button>
            </form>
        </div>
        <%}%>


        <div>
            <form action="/listings/<%= listing._id %>" method="get">
            <button class="btn btn-outline-danger">Book Now</button>
        </form>
        </div>
    </div>
    <!-- ---------------------------------------Review section------------------------------------------- -->

    <%if(currUser){%>
    <hr>
    <div class="review">
        <h4>Leave a Review</h4>
        <form action="/listings/<%=listing._id %>/review" method="POST" class="needs-validation"  novalidate>
            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[likes]" value="0" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[likes]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[likes]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[likes]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[likes]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[likes]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            <div>
                <label for="comment" class="form-label">Comment</label><br>
                <textarea name="review[comment]" id="comment" class="form-control" rows="5" required></textarea>
                <div class="invalid-feedback">Comment is required !!</div>
            </div>
            <br>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
    </div>
    <%}%>
    <hr>

    <!-- -----------------------------------------------All Reviews Section---------------------------------- -->
     <% if (listing.reviews.length) { %>
        <h3>Reviews</h3>
    <div class="reviews-container">
        <button class="scroll-btn prev-btn" aria-label="Scroll Left">
            <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="all-reviews hide-scrollbar" id="review-scroll-container">
            <% for( let review of listing.reviews ) { %>
                <div class="review-card card" style="width: 18rem;">
                    <div class="card-body px-4 py-auto">
                        <h6 class="card-subtitle mb-2 text-body-secondary d-flex">
                            <div class="user-review-icon">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            &nbsp;@<%= review.author.username%>
                        </h6>
                        <p class="starability-result review-star" data-rating="<%=review.likes%>"></p>
                        <p class="card-text"><b><i><%= review.comment%></i></b></p>
                        <br>
                        <%if(currUser && currUser._id.equals(review.author._id)){%>
                        <form action="/listings/<%= listing._id%>/review/<%=review._id%>?_method=DELETE" method="post">
                            <button class="btn btn-dark review-btn-del">Delete</button>
                        </form>
                        <%}%>
                    </div>
                </div>
            <% } %>
        </div>

        <button class="scroll-btn next-btn" aria-label="Scroll Right">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
    </div>
     <% } %>

    <!-- -----------------------------------------------------------Map---------------------------------------------- -->
     <hr>
    <h3>Where you'll be</h3>
    <div id="map"></div>
</div>

<script src="/JS/map.js"></script>
<script src="/JS/show.js"></script>


    
