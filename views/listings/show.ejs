<%- layout('/layouts/boilerplate.ejs') -%>
<div class="show-wrapper mx-auto">
    <h2 class="show-title"><%= listing.title %></h2>
    <img src="<%= listing.image %>" width="500px" height="400px" alt="Image" class="show-img">
    <div class="show-desc">
        
        <p>₹ <%= listing.price.toLocaleString("en-IN") %>/night </p>
        <p class="italic"><%= listing.description %></p>
        <p class="italic"><%= listing.location %>,<%= listing.country%></p>

        <p class="">-  <%= listing.owner.username%></p>
    </div>
    <!-- <div><%=currUser,listing%>,,,,,<%=listing%></div> -->
    <%if (currUser && currUser._id.equals(listing.owner._id)){%>
    <div class="show-btns">
        <form action="/listings/<%= listing._id %>/edit" method="get">
            <button class="btn btn-danger">Edit</button> 
        </form>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <button class="btn btn-dark">Delete</button>
        </form>
    </div>
    <%}%>
    <!-- ---------------------------------------Review section------------------------------------------- -->
    <%if(currUser){%>
    <hr>
    <div class="review">
        <h4>Leave a Review</h4>
        <form action="/listings/<%=listing._id %>/review" method="POST" class="needs-validation"  novalidate>
            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[likes]" value="0" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[likes]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[likes]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[likes]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[likes]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[likes]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            <div>
                <label for="comment" class="form-label">Comment</label><br>
                <textarea name="review[comment]" id="comment" class="form-control" rows="5" required></textarea>
                <div class="invalid-feedback">Comment is required !!</div>
            </div>
            <br>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
    </div>
    <%}%>
    <hr>

    <!-- -----------------------------------------------All Reviews Section---------------------------------- -->
    <div class="reviews">
        <h4>All Reviews</h4>
        <div class="all-reviews ">
            <% for( let review of listing.reviews ) { %>
                <div class="review-card card " style="width: 18rem;">
                    <div class="card-body">
                        <!-- <h5 class="card-title">Rishi</h5> -->
                        <h6 class="card-subtitle mb-2 text-body-secondary d-flex ">
                            <div class="user-review-icon">
                                <i class="fa-solid fa-user "></i>
                            </div>
                             &nbsp;@<%= review.author.username%></h6>
                             <p class="starability-result" data-rating="<%=review.likes%>"></p>
                        <p class="card-text"><%= review.comment%></p>
                    </div>
                    <br>
                    <%if(currUser && currUser._id.equals(review.author._id)){%>
                    <form action="/listings/<%= listing._id%>/review/<%=review._id%>?_method=DELETE" method="post">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                    <%}%>
                </div>
            <% } %>
        </div>
    </div>

</div>

    
