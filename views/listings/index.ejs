<%- layout('/layouts/boilerplate.ejs') -%>
    <!-- <form method="GET"action="/listings/new">
        <button >Create New Listing</button>
    </form> -->
    <div class="body-wrapper mx-auto pt-2 ">
        <h3>All Listings</h3>

        <div class="container align-items-space-around pt-4 row row-cols-lg-4 row-cols-xs-1   row-cols-md-2">
            <% for( let listing of allListing  ) { %>
                <a href="/listings/<%= listing._id %> "  class='card-link'>
                    <div class="card" style="width: 18rem;height: 18rem;">

                        <img src="<%= listing.image %>" class="card-img-top " alt="<%= listing.title %>">

                        
                       
                        <div class="card-body ">
                            <p class="card-title"><%= listing.title %></p>
                            <p class="card-price">₹ <%= listing.price.toLocaleString("en-IN") %>/night</p>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>

    </div>
    
