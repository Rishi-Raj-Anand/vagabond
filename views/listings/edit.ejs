<%- layout('/layouts/boilerplate.ejs') -%>

<body>
    <h3>Edit Listing</h3>
    <form action="/listings/<%=listing._id%>?_method=PUT" method="POST">
        <label for="title">Title:</label>
        <input type="text" name="listing[title]" id="title" value="<%=listing.title%>">
        <br>
        <br>
        
        <label for="price">Price:₹</label>
        <input type="number" name="listing[price]" id="price" value="<%=listing.price%>" >
        <br><br>
        <label for="image">Image:</label>
        <input type="url" name="listing[image]" id="image" value="<%=listing.image%>">
        <br><br>
        <label for="location">Location:</label>
        <input type="text" name="listing[location]" id="location" value="<%=listing.location%>">
        <br><br>
        <label for="country">Country:</label>
        <input type="text" name="listing[country]" id="country" value="<%=listing.country%>">
        <br><br>
        <label for="desc">Description:</label>
        <br>
        <textarea name="listing[description]" id="desc" cols="30" rows="5" ><%=listing.description%></textarea>
        <br><br>
        <button>Submit</button>
    </form>
</body>

