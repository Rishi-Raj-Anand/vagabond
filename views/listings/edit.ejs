<%- layout('/layouts/boilerplate.ejs') -%>

    

<div class="form-wrapper mx-auto ">
    <h3>Edit Listing</h3>
    <form action="/listings/<%=listing._id%>?_method=PUT" method="POST">

        <div class="full-width">
            <label for="title" class="form-label">Title:</label>
            <input type="text" name="listing[title]" id="title" value="<%=listing.title%>" class="form-control ">
        </div>

        <div class="form-2part full-width">
            <div class=" x2">
                <label for="price" class="form-label">Price:₹</label>
                <input type="number" name="listing[price]" id="price" value="<%=listing.price%>"  class="form-control">
            </div>
            
            <div class="x2">
                <label for="image" class="form-label">Image:</label>
                <input type="url" name="listing[image]" id="image" value="<%=listing.image%>" class="form-control">
            </div>
        </div>
        
        <div class="form-2part full-width">
            <div class="full-width x2">
                <label for="location" class="form-label">Location:</label>
                <input type="text" name="listing[location]" id="location" value="<%=listing.location%>" class="form-control ">
            </div>
            
            <div class="full-width x2">
                <label for="country" class="form-label">Country:</label>
                <input type="text" name="listing[country]" id="country" value="<%=listing.country%>" class="form-control">
            </div>
        </div>
        
        <div class="full-width">
            <label for="desc" class="form-label">Description:</label>
            <br>
            <textarea name="listing[description]" id="desc" cols="30" rows="5"  class="form-control"><%=listing.description%></textarea>
            <br>
        </div>
        <button class="btn btn-danger form-btn">Submit</button>
    </form>
</div>

